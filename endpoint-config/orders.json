{
  "module": "orders",
  "endpoints": [
    {
      "method": "POST",
      "route": "/api/orders",
      "purpose": "Place a new customer order",
      "actor": "customer",
      "auth": "JWT required (role=customer)",
      "permission": null,
      "regionRequirements": "Header X-Region or query ?region (default 'eg')",
      "headers": ["Idempotency-Key"],
      "requestDTO": "CreateOrderDTO",
      "responseDTO": "OrderResponseDTO",
      "successCode": 201,
      "errorCodes": [400, 401, 404, 409, 500],
      "idempotency": true,
      "transactions": true,
      "cacheBehavior": "None",
      "invalidation": "None",
      "databaseDependencies": ["orders", "order_items", "idempotency_keys"],
      "coreDependencies": ["validate-batch (products)", "customer address", "branch status"],
      "webSocketSideEffects": ["order:created (to branch)"]
    },
    {
      "method": "GET",
      "route": "/api/orders/:publicId",
      "purpose": "Retrieve order details by public UUID",
      "actor": "customer, restaurant_user, delivery_agent, system_admin",
      "auth": "JWT required",
      "permission": "Ownership check (customer) OR rbac(orders:order:read)",
      "regionRequirements": "Resolved from order or request region",
      "headers": [],
      "requestDTO": null,
      "responseDTO": "OrderResponseDTO",
      "successCode": 200,
      "errorCodes": [401, 403, 404, 500],
      "idempotency": false,
      "transactions": false,
      "cacheBehavior": "Cacheable for delivered/cancelled states (TTL 300s)",
      "invalidation": "Invalidate on order state mutation",
      "databaseDependencies": ["orders", "order_items"],
      "coreDependencies": [],
      "webSocketSideEffects": []
    },
    {
      "method": "GET",
      "route": "/api/orders",
      "purpose": "List orders with filters and cursor pagination",
      "actor": "restaurant_user, system_admin",
      "auth": "JWT required",
      "permission": "rbac(orders:order:read), requireRestaurantMember, requireBranchAccess",
      "regionRequirements": "X-Region or ?region",
      "headers": [],
      "requestDTO": null,
      "responseDTO": "OrderResponseDTO[]",
      "successCode": 200,
      "errorCodes": [400, 401, 403, 500],
      "idempotency": false,
      "transactions": false,
      "cacheBehavior": "Short-lived cache for pending feeds (TTL 10s)",
      "invalidation": "Invalidate on branch order updates",
      "databaseDependencies": ["orders", "order_items"],
      "coreDependencies": [],
      "webSocketSideEffects": []
    },
    {
      "method": "PATCH",
      "route": "/api/orders/:publicId/status",
      "purpose": "Update order status in lifecycle state machine",
      "actor": "restaurant_user, system_admin",
      "auth": "JWT required",
      "permission": "rbac(orders:order:update_status)",
      "regionRequirements": "X-Region or ?region",
      "headers": [],
      "requestDTO": "UpdateOrderStatusDTO",
      "responseDTO": "OrderStatusResponseDTO",
      "successCode": 200,
      "errorCodes": [400, 401, 403, 404, 409, 500],
      "idempotency": true,
      "transactions": true,
      "cacheBehavior": "None",
      "invalidation": "Invalidate order caches",
      "databaseDependencies": ["orders"],
      "coreDependencies": [],
      "webSocketSideEffects": ["order:status_updated (to customer and branch)"]
    }
  ]
}
