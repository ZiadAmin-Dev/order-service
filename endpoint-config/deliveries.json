{
  "module": "deliveries",
  "endpoints": [
    {
      "method": "POST",
      "route": "/api/deliveries/:orderPublicId/assign",
      "purpose": "Manually assign delivery agent to order (restaurant override)",
      "actor": "restaurant_user, system_admin",
      "auth": "JWT required",
      "permission": "rbac(orders:delivery:manual_assign), requireRestaurantMember, requireBranchAccess",
      "regionRequirements": "X-Region or ?region",
      "headers": [],
      "requestDTO": "ManualAssignDeliveryDTO",
      "responseDTO": "DeliveryAssignmentResponseDTO",
      "successCode": 200,
      "errorCodes": [400, 401, 403, 404, 409, 500],
      "idempotency": true,
      "transactions": true,
      "cacheBehavior": "None",
      "invalidation": "Invalidate agent and order caches",
      "databaseDependencies": ["orders", "agent_presence"],
      "coreDependencies": [],
      "webSocketSideEffects": ["delivery:assigned (to agent)"]
    },
    {
      "method": "PATCH",
      "route": "/api/deliveries/:orderPublicId/pickup",
      "purpose": "Mark order picked up by delivery driver",
      "actor": "delivery_agent",
      "auth": "JWT required (role=delivery_agent)",
      "permission": null,
      "regionRequirements": "X-Region or ?region",
      "headers": [],
      "requestDTO": null,
      "responseDTO": "OrderStatusResponseDTO",
      "successCode": 200,
      "errorCodes": [400, 401, 403, 404, 409, 500],
      "idempotency": true,
      "transactions": true,
      "cacheBehavior": "None",
      "invalidation": "Invalidate order cache",
      "databaseDependencies": ["orders"],
      "coreDependencies": [],
      "webSocketSideEffects": ["order:out_for_delivery (to customer and branch)"]
    },
    {
      "method": "PATCH",
      "route": "/api/deliveries/:orderPublicId/delivered",
      "purpose": "Mark order delivered at doorstep and trigger settlement",
      "actor": "delivery_agent",
      "auth": "JWT required (role=delivery_agent)",
      "permission": null,
      "regionRequirements": "X-Region or ?region",
      "headers": [],
      "requestDTO": null,
      "responseDTO": "DeliveryFulfillmentResponseDTO",
      "successCode": 200,
      "errorCodes": [400, 401, 403, 404, 409, 500],
      "idempotency": true,
      "transactions": true,
      "cacheBehavior": "None",
      "invalidation": "Invalidate order and balance caches",
      "databaseDependencies": ["orders", "transactions", "restaurant_balances", "agent_earnings"],
      "coreDependencies": ["branch commission rate"],
      "webSocketSideEffects": ["order:delivered (to customer and branch)"]
    }
  ]
}
