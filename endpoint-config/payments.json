{
  "module": "payments",
  "endpoints": [
    {
      "method": "POST",
      "route": "/api/payments/init",
      "purpose": "Initialize Kashier v3 payment session for an order",
      "actor": "customer",
      "auth": "JWT required (role=customer)",
      "permission": null,
      "regionRequirements": "X-Region or ?region",
      "headers": ["Idempotency-Key"],
      "requestDTO": "InitPaymentDTO",
      "responseDTO": "PaymentSessionResponseDTO",
      "successCode": 200,
      "errorCodes": [400, 401, 404, 502, 500],
      "idempotency": true,
      "transactions": true,
      "cacheBehavior": "None",
      "invalidation": "None",
      "databaseDependencies": ["orders", "transactions", "payment_providers"],
      "coreDependencies": [],
      "webSocketSideEffects": []
    },
    {
      "method": "POST",
      "route": "/api/payments/webhook",
      "purpose": "Process asynchronous Kashier v3 payment notifications",
      "actor": "Kashier payment gateway (public/unauthenticated)",
      "auth": "HMAC-SHA256 signature verification via x-kashier-signature header",
      "permission": null,
      "regionRequirements": "Derived from order data in webhook payload",
      "headers": ["x-kashier-signature"],
      "requestDTO": "KashierWebhookDTO",
      "responseDTO": "GenericSuccessResponseDTO",
      "successCode": 200,
      "errorCodes": [400, 401, 500],
      "idempotency": true,
      "transactions": true,
      "cacheBehavior": "None",
      "invalidation": "Invalidate order cache",
      "databaseDependencies": ["transactions", "orders"],
      "coreDependencies": [],
      "webSocketSideEffects": ["order:placed or order:payment_failed"]
    }
  ]
}
